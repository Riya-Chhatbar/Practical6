@model IEnumerable<program6.Models.product>

@{
    ViewBag.Title = "Product Catalog";
}

<h2>Product Catalog</h2>


<table class="table table-bordered table-striped">

    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Description</th>
        <th>Image</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Category</td>
            <td>₹ @item.Price</td>
            <td>@item.Description</td>

            <td>
                <img src="@item.ImageUrl"
                     width="100"
                     height="100"
                     alt="@item.Name" />
            </td>

            <td>
                @Html.ActionLink("Details", "Details",
                    new { id = item.Id },
                    new { @class = "btn btn-info" })

            </td>
        </tr>
    }

</table>
